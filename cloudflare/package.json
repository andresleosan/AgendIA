{
  "name": "agendia-cloudflare-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.22.1 <25" },
  "scripts": {
    "test": "node --test tests/agendia-*.test.mjs",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --config wrangler.jsonc --env-interface AgendiaBindings agendia-configuration.d.ts",
    "dry-run": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler/dry-run",
    "dry-run:worker": "wrangler deploy --config wrangler.jsonc --dry-run --containers-rollout=none --outdir .wrangler/dry-run",
    "check": "pnpm test && pnpm run typecheck && pnpm run dry-run:worker"
  },
  "dependencies": { "@cloudflare/containers": "0.3.7" },
  "devDependencies": { "@types/node": "^24", "typescript": "^5.9.3", "wrangler": "4.150.0" }
}
