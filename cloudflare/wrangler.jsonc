{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agendia-web",
  "main": "src/agendia-ui.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false, "logs": { "enabled": false }, "traces": { "enabled": false } },
  "containers": [{
    "class_name": "AgendiaWeb",
    "scheduling_policy": "default",
    "image": "../Dockerfile",
    "image_build_context": "..",
    "instance_type": "basic",
    "max_instances": 1,
    "observability": { "enabled": false },
    "image_vars": {
      "NEXT_PUBLIC_FIREBASE_API_KEY": "",
      "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "",
      "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "",
      "NEXT_PUBLIC_FIREBASE_APP_ID": ""
    }
  }],
  "durable_objects": { "bindings": [{ "name": "AGENDIA_UI", "class_name": "AgendiaWeb" }] },
  "exports": { "AgendiaWeb": { "type": "durable-object", "storage": "sqlite" } }
}
